{
  "name": "@gow/db",
  "version": "0.1.0",
  "private": true,
  "description": "Esquema de negocio en Postgres con Drizzle: tablas por tenant con RLS forzada, roles de base mínimos, migraciones y conexión por rol con app.tenant_id por transacción.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/cli/migrate.ts",
    "db:roles": "tsx src/cli/roles.ts"
  },
  "dependencies": {
    "@gow/contracts": "workspace:*",
    "drizzle-orm": "0.45.4",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11"
  }
}
