{
  "name": "gow-credit",
  "version": "0.0.0",
  "private": true,
  "description": "Extracción y diagnóstico crediticio sobre estados de cuenta bancarios (worksample GOW Credit)",
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "typecheck": "pnpm -r --if-present run typecheck",
    "lint": "node --max-old-space-size=8192 node_modules/eslint/bin/eslint.js . --max-warnings 0",
    "dup": "jscpd",
    "test": "vitest run",
    "test:watch": "vitest",
    "schema:export": "pnpm -F @gow/contracts schema:export",
    "extract": "pnpm -F @gow/extraction extract",
    "eval": "pnpm -F @gow/evals eval",
    "scenario": "pnpm -F @gow/scenarios scenario",
    "decide": "pnpm -F @gow/decision decide",
    "simulate": "pnpm -F @gow/decision simulate",
    "evaluate": "pnpm -F @gow/mastra evaluate",
    "db:migrate": "pnpm -F @gow/db db:migrate",
    "db:generate": "pnpm -F @gow/db db:generate",
    "worker": "pnpm -F @gow/worker start",
    "api": "pnpm -F @gow/api start",
    "tenant": "pnpm -F @gow/api tenant",
    "whatsapp": "pnpm -F @gow/whatsapp start",
    "demo:load": "pnpm -F @gow/api demo",
    "demo:reset": "pnpm -F @gow/api reset",
    "corrections:export": "pnpm -F @gow/api corrections export",
    "web": "pnpm -F @gow/web dev",
    "supabase:env": "sh scripts/supabase-env.sh",
    "supabase:up": "docker compose -f docker-compose.supabase.yml --env-file infra/supabase/.env up -d --wait",
    "stack:up": "sh scripts/stack.sh up",
    "stack:down": "sh scripts/stack.sh down",
    "stack:reset": "sh scripts/stack.sh reset",
    "stack:logs": "sh scripts/stack.sh logs",
    "stack:ps": "sh scripts/stack.sh ps",
    "supabase:down": "docker compose -f docker-compose.supabase.yml --env-file infra/supabase/.env down",
    "doctor": "node scripts/doctor.mjs",
    "data:pack": "bash scripts/eval-bundle.sh pack",
    "data:unpack": "bash scripts/eval-bundle.sh unpack"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "eslint-plugin-sonarjs": "4.2.2",
    "globals": "17.13.0",
    "jscpd": "5.4.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "4.1.12"
  }
}
