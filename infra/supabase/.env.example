# Plantilla del Supabase local (docker-compose.supabase.yml). No la copies a mano: corre
# `pnpm supabase:env`, que escribe infra/supabase/.env (ignorado por git) llenando los secretos
# vacíos con valores aleatorios. SOLO DESARROLLO LOCAL: el stack escucha en 127.0.0.1 y nada de
# esto sirve para un despliegue.

# --- Secretos (los genera scripts/supabase-env.sh) ---------------------------------------
POSTGRES_PASSWORD=
# JWT secret del proyecto (HS256). La API lo usa como BACKOFFICE_JWT_SECRET (ADR 0019).
JWT_SECRET=
# Llaves anon y service_role: JWT HS256 firmados con JWT_SECRET (role, iss, iat, exp a 5 años).
ANON_KEY=
SERVICE_ROLE_KEY=
# Studio también se publica en / del gateway con autenticación básica.
DASHBOARD_USERNAME=supabase
DASHBOARD_PASSWORD=
PG_META_CRYPTO_KEY=
# No es de Supabase: firma de las URL de subida de la API (STORAGE_SIGNING_SECRET en app.env).
GOW_STORAGE_SIGNING_SECRET=

# --- Puertos en el host (todos en 127.0.0.1) ----------------------------------------------
GOW_SUPABASE_DB_PORT=54340
GOW_SUPABASE_API_PORT=54341
GOW_SUPABASE_STUDIO_PORT=54342
GOW_SUPABASE_MAIL_PORT=54343

# --- URLs ----------------------------------------------------------------------------------
# Deben coincidir con GOW_SUPABASE_API_PORT.
SUPABASE_PUBLIC_URL=http://127.0.0.1:54341
API_EXTERNAL_URL=http://127.0.0.1:54341/auth/v1
# El backoffice (pnpm web): destino de los magic links.
SITE_URL=http://127.0.0.1:5173
ADDITIONAL_REDIRECT_URLS=http://127.0.0.1:5173/**,http://localhost:5173/**

# --- Auth ----------------------------------------------------------------------------------
JWT_EXPIRY=3600
DISABLE_SIGNUP=false
# false: los correos de confirmación y los magic links llegan a Inbucket (http://127.0.0.1:54343).
ENABLE_EMAIL_AUTOCONFIRM=false
SMTP_ADMIN_EMAIL=admin@gow.local
SMTP_SENDER_NAME=GOW Credit (local)
