# Template for the local Supabase (docker-compose.supabase.yml). Don't copy it by hand: run
# `pnpm supabase:env`, which writes infra/supabase/.env (git-ignored) with random values for the
# empty secrets. LOCAL DEV ONLY: the stack listens on 127.0.0.1 and none of this suits a deployment.

# --- Secrets (generated by scripts/supabase-env.sh) ---------------------------------------
POSTGRES_PASSWORD=
# Project JWT secret (HS256). The API reads it as BACKOFFICE_JWT_SECRET.
JWT_SECRET=
# anon and service_role keys: HS256 JWTs signed with JWT_SECRET (role, iss, iat, exp 5 years out).
ANON_KEY=
SERVICE_ROLE_KEY=
# Studio is also served at / on the gateway, behind basic auth.
DASHBOARD_USERNAME=supabase
DASHBOARD_PASSWORD=
PG_META_CRYPTO_KEY=
# Not a Supabase setting: signs the API's upload URLs (STORAGE_SIGNING_SECRET in app.env).
GOW_STORAGE_SIGNING_SECRET=

# --- Host ports (all on 127.0.0.1) ----------------------------------------------
GOW_SUPABASE_DB_PORT=54340
GOW_SUPABASE_API_PORT=54341
GOW_SUPABASE_STUDIO_PORT=54342
GOW_SUPABASE_MAIL_PORT=54343

# --- URLs ----------------------------------------------------------------------------------
# Must match GOW_SUPABASE_API_PORT.
SUPABASE_PUBLIC_URL=http://127.0.0.1:54341
API_EXTERNAL_URL=http://127.0.0.1:54341/auth/v1
# The backoffice (pnpm web): where magic links point.
SITE_URL=http://127.0.0.1:5173
ADDITIONAL_REDIRECT_URLS=http://127.0.0.1:5173/**,http://localhost:5173/**

# --- Auth ----------------------------------------------------------------------------------
JWT_EXPIRY=3600
# false: confirmation emails and magic links land in Inbucket (http://127.0.0.1:54343).
ENABLE_EMAIL_AUTOCONFIRM=false
SMTP_ADMIN_EMAIL=admin@gow.local
SMTP_SENDER_NAME=GOW Credit (local)
