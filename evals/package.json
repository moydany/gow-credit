{
  "name": "@gow/evals",
  "version": "0.1.0",
  "private": true,
  "description": "Ground truth y evals de extracción (fase 3): precisión y recall de movimientos, exactitud por campo, cuadre a la primera, inyección.",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "gt:build": "tsx src/ground-truth/build.ts",
    "eval": "evalite run --hideTable && tsx src/gate.ts",
    "eval:ui": "evalite serve",
    "score": "tsx src/score-dir.ts",
    "corrections": "tsx src/corrections.ts",
    "gt:review": "tsx src/ground-truth/review.ts"
  },
  "dependencies": {
    "@gow/contracts": "workspace:*",
    "@gow/extraction": "workspace:*",
    "@gow/llm": "workspace:*",
    "evalite": "0.19.0",
    "pdfjs-dist": "6.4.299",
    "zod": "4.6.7"
  },
  "exports": {
    "./adversarial": "./src/adversarial.ts"
  }
}
