# Modo de ejecución: standalone (evaluadores, CI) o full (Supabase, pg-boss, Baileys, Resend)
GOW_MODE=standalone

# --- Requerido en ambos modos ---------------------------------------------------
# Única variable necesaria para `pnpm run evaluate <carpeta>`.
ANTHROPIC_API_KEY=
ANTHROPIC_WORKSPACE_ID=

GEMINI_API_KEY=
# --- Opcional -------------------------------------------------------------------
# Jev (TypeSafe AI). Sin ella, el clasificador usa claude-haiku-5-5 y el reporte lo indica.
TYPESAFE_API_KEY=
# Nivel de log de pino: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# --- Modo full (fase 6) ---------------------------------------------------------
# Postgres de Supabase o el de docker compose local.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=

# --- Observabilidad opcional ------------------------------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=

STORAGE_SIGNING_SECRET=
# Firma de los JWT del backoffice (en Supabase, el JWT secret del proyecto)
BACKOFFICE_JWT_SECRET=

GOW_TIME_ZONE=America/Mexico_City
