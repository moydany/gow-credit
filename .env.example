# Copia este archivo a .env y llena lo que necesites. .env está ignorado por git.

# Modo de ejecución: standalone (evaluadores, CI) o full (Supabase, pg-boss, Baileys, Resend)
GOW_MODE=standalone

# --- Requerido en ambos modos ---------------------------------------------------
# Clasificación de respaldo, doble lectura, aclaraciones y emergencia de extracción.
# Con solo esta llave, `pnpm run evaluate <carpeta>` funciona: extrae con claude-opus-5-5.
ANTHROPIC_API_KEY=
# Solo si tu llave no está ligada a un workspace (la API responde que falta
# anthropic-workspace-id). Con una llave normal se deja vacío.
ANTHROPIC_WORKSPACE_ID=

# --- Recomendado -----------------------------------------------------------------
# Extracción con gemini-3.8-flash (ADR 0011): unas 5 veces más barata que Opus. Con esta
# llave, los PDFs se mandan a Google. También se acepta GOOGLE_GENERATIVE_AI_API_KEY.
GEMINI_API_KEY=

# --- Opcional -------------------------------------------------------------------
# Jev (TypeSafe AI). Sin ella, el clasificador usa claude-haiku-5-5 y el reporte lo indica.
TYPESAFE_API_KEY=

# Nivel de log de pino: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# --- Modo full (fase 6) ---------------------------------------------------------
# docker compose up -d levanta Postgres 17 en 127.0.0.1:54330 con los roles de docs/05 §2; sin
# estas variables, cada proceso usa ese Postgres con su rol de desarrollo. En Supabase, una URL por
# rol (cada proceso conecta con el suyo, nunca con el de migraciones). Para el Supabase local
# (docker-compose.supabase.yml), `pnpm supabase:env` genera estas variables en infra/supabase/app.env.
DATABASE_ADMIN_URL=
DATABASE_URL_API=
DATABASE_URL_WORKER=
DATABASE_URL_WHATSAPP=
DATABASE_URL_READONLY=
DATABASE_URL_QUEUE=
DATABASE_URL_MASTRA=
# Firma de las URL de subida (cualquier cadena larga y aleatoria) y dónde quedan los documentos.
STORAGE_SIGNING_SECRET=
STORAGE_DIR=
API_PUBLIC_URL=http://127.0.0.1:3000
PORT=3000
# Caché de respuestas de modelos del worker: readwrite | read | off.
LLM_CACHE_MODE=readwrite
WORKER_MODEL_CONCURRENCY=3
# Correo (Resend): envío de aclaraciones y webhook firmado de correo entrante.
RESEND_API_KEY=
RESEND_FROM=
RESEND_WEBHOOK_SECRET=
# WhatsApp (Baileys): una sesión por tenant; la primera vez imprime el QR para vincular el número.
WHATSAPP_TENANT_ID=
WHATSAPP_AUTH_DIR=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Observabilidad opcional ------------------------------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=

# --- Backoffice (fase 7) ----------------------------------------------------------
# Secreto HS256 con el que la API verifica el JWT de sesión (`sub`, `email`, `tenant_id`, `exp`).
# En Supabase es el JWT secret del proyecto; en local lo usa `pnpm tenant user add`. Sin él, /bo/v1 está apagado.
BACKOFFICE_JWT_SECRET=
# URL del backoffice para el enlace de acceso que imprime el CLI.
BACKOFFICE_URL=http://127.0.0.1:5173
