# Copy to .env. `pnpm stack:up` generates every database and auth secret itself; this file only
# holds your own keys and a few switches.

# Required. Double read, fallback extraction, classification fallback and supplier messages.
ANTHROPIC_API_KEY=
# Only for keys that the API rejects without a workspace header.
ANTHROPIC_WORKSPACE_ID=

# Recommended. Extraction with Gemini 3.8 Flash; without it Claude Opus extracts at ~5x the cost.
GEMINI_API_KEY=

# Optional. Classification with Jev (TypeSafe AI); without it Claude Haiku classifies.
TYPESAFE_API_KEY=

# Optional. Sign-in emails through Resend; without it they land in the local inbox at :54343.
RESEND_API_KEY=
RESEND_FROM=

# readwrite (default) calls the models and caches answers; read never calls them and fails when an
# answer is missing, so a rerun costs nothing.
LLM_CACHE_MODE=readwrite
# Model calls in flight at once across the worker.
WORKER_MODEL_CONCURRENCY=3
# Unknown numbers can register over WhatsApp by sending their statement. Set false to turn it off.
WHATSAPP_SELF_REGISTRATION=true
# Business calendar for dates, statement age and message times.
GOW_TIME_ZONE=America/Mexico_City
